# Copy this file to .env and fill in every value. Never commit .env.

# Your user and group ids on the host (run: id -u, id -g)
HOST_UID=
HOST_GID=
# Group id of the docker group on the host (run: getent group docker | cut -d: -f3)
DOCKER_GID=
# Absolute path of this project on the host (run: pwd)
HOST_PROJECT_DIR=

# Kaggle API token (https://www.kaggle.com/settings), used only to download the dataset
KAGGLE_API_TOKEN=

# Passwords and secrets: generate each one with  openssl rand -hex 16
POSTGRES_PASSWORD=
AIRFLOW_DB_PASSWORD=
AIRFLOW_JWT_SECRET=
# Fernet key: openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=
